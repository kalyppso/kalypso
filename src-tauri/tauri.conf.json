{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KALYPSO",
  "version": "0.2.0",
  "identifier": "dev.kalypso.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KALYPSO",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4OTFDNkRFNUNCMzEwRkUKUldUK0VMTmMzc2FSdUV1T3ppQWJqdnVwWENHT1NQK0l3SGQxYm43YzFCU0x1WnJ5cnBONUIvZWsK",
      "endpoints": [
        "https://github.com/kalyppso/kalypso/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
