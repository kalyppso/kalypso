# KALYPSO agent runner: the image for sandboxes whose agents use the Claude Agent SDK.
# Build: podman build -t ghcr.io/kalyppso/agent-runner:latest runner/agent-sdk
# Your own image works too, if it is built FROM this one.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git curl ripgrep procps python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/kalypso/runner
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY runner.mjs openai.mjs kx-secret.mjs kx-agent.mjs ./
RUN ln -s /opt/kalypso/runner/kx-secret.mjs /usr/local/bin/kx-secret && ln -s /opt/kalypso/runner/kx-agent.mjs /usr/local/bin/kx-agent && chmod 755 kx-secret.mjs kx-agent.mjs

LABEL org.opencontainers.image.title="KALYPSO agent runner" \
      org.opencontainers.image.description="Runs KALYPSO agents (Claude Agent SDK, or any OpenAI-compatible model) inside sandboxes" \
      org.opencontainers.image.source="https://github.com/kalyppso/kalypso" \
      dev.kalypso.runner="agent-sdk"

WORKDIR /work
